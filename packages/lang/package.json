{
  "name": "@av/atem-lang",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Command languages for an ATEM fleet: a typed grammar, state paths, raw command codes, JSON and OSC, over a catalogue generated from atem-connection's own types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "tsx tools/generate.ts"
  },
  "dependencies": {
    "atem-connection": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
