node_modules/
dist/
out/
*.log
.DS_Store
atem-crosspoint.config.json

# Captures are a switcher's whole state: the streaming block, the recording
# filename (often a client or job name), every input name. The stream key is
# redacted on the way out, but the rest is still someone's show.
captures/
*.tsbuildinfo
dist-sim/

# Launcher payload: the embedded Node runtime and staged app tree are big and
# regenerable. They ship inside the release bundle, not in the repo.
launcher/src-tauri/node
launcher/src-tauri/node.exe
launcher/src-tauri/blackmatrix-app/
launcher/src-tauri/target/

# Mobile: Rust build output and the Xcode build dir. The generated Xcode project
# itself is kept, so a build does not depend on re-running `tauri ios init`.
mobile/src-tauri/target/
mobile/src-tauri/gen/apple/build/
mobile/src-tauri/gen/apple/Externals/
mobile/src-tauri/gen/apple/*.xcworkspace/xcuserdata/
mobile/src-tauri/gen/apple/Pods/

# Signing material. The key is the identity of every future update of the app —
# Android refuses an update signed by a different one — so it lives outside the
# repo entirely. See docs/signing.md.
mobile/src-tauri/gen/android/keystore.properties
*.jks
*.keystore
